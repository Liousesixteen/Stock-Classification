DEEPSEEK_API_KEY=
AI_RESEARCH_SHARE_WEBHOOK_URL=
AI_RESEARCH_SHARE_WEBHOOK_FORMAT=generic
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
CLASSIFICATION_AGENT_PROVIDER=rules

# Yidianx market service is started together with the main project.
RICH_WORKBENCH_PYTHON_BIN=python3
RICH_WORKBENCH_HOST=127.0.0.1
RICH_WORKBENCH_PORT=8765

# Vendored DA-Stock ask-stock engine. Existing DeepSeek variables remain the
# primary model; the upstream private .env can add its original fallback channels.
DA_STOCK_PYTHON=services/da-stock/.venv/bin/python
DA_STOCK_IMAGE=stock-classification-research:local
AGENT_ARCH=multi
DA_STOCK_BACKTEST_DB=./data/da-stock/stock_analysis.db

# Optional full FinSight report engine. Keep native as the safe default until
# Python dependencies, Pandoc, VLM, and Embedding are ready.
FINSIGHT_REPORT_ENGINE=native
FINSIGHT_PYTHON_BIN=services/finsight/.venv/bin/python
FINSIGHT_RUNS_DIR=./data/finsight-runs
FINSIGHT_ENABLE_CHARTS=true
FINSIGHT_MAX_CONCURRENT=3
FINSIGHT_MAX_ITERATIONS=20
FINSIGHT_RESUME=true
FINSIGHT_GENERATE_TASKS=true
FINSIGHT_ADD_REFERENCES=true
FINSIGHT_VLM_MODEL_NAME=
FINSIGHT_VLM_BASE_URL=
FINSIGHT_VLM_API_KEY=
FINSIGHT_EMBEDDING_MODEL_NAME=
FINSIGHT_EMBEDDING_BASE_URL=
FINSIGHT_EMBEDDING_API_KEY=

# Production access control. Leave empty for local-only development.
STOCK_APP_BASIC_AUTH_USER=
STOCK_APP_BASIC_AUTH_PASSWORD=
STOCK_OPERATIONS_TOKEN=
STOCK_FORCE_HTTPS=false

# Per-client request limits in a rolling fixed window.
STOCK_RATE_LIMIT_WINDOW_MS=60000
STOCK_RATE_LIMIT_AI_PER_MINUTE=12
STOCK_RATE_LIMIT_WRITE_PER_MINUTE=120
STOCK_RATE_LIMIT_READ_PER_MINUTE=360
STOCK_API_MAX_BODY_BYTES=2097152
STOCK_IMPORT_MAX_BYTES=10485760

# SQLite and operational backups.
STOCK_CLASSIFICATION_DB_PATH=./data/stock-classification.sqlite
# empty: create/migrate the database without sample records; sample: add missing built-in sample records.
STOCK_BOOTSTRAP_MODE=empty
STOCK_DB_ENFORCE_PRIVATE_PERMISSIONS=true
STOCK_BACKUP_DIR=./backups

# External providers are disabled until their commercial use is approved.
# Available: eastmoney_push2,tencent_quote,eastmoney_f10_company_survey,eastmoney_f10_business_analysis,
#            baidu_related_blocks,cninfo_announcements,eastmoney_reports,
#            sina_income_statement,sina_balance_sheet,sina_cash_flow
STOCK_PROFILE_SOURCE_PRIORITY=disabled
STOCK_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
STOCK_PROVIDER_CIRCUIT_COOLDOWN_MS=60000
STOCK_PROFILE_PROVIDER_TIMEOUT_MS=10000

# Optional bridge to DA-Stock's configured market/news provider CLI. The .env
# remains outside this repository so API keys are never copied into Git.
DA_STOCK_PYTHON_BIN=python3
DA_STOCK_PROVIDER_CLI=
DA_STOCK_ENV_PATH=
DA_STOCK_PROVIDER_TIMEOUT_MS=24000
STOCK_SYNC_DISPATCHER_ENABLED=true
STOCK_SYNC_DISPATCHER_CONCURRENCY=2
STOCK_SYNC_DISPATCHER_POLL_MS=2000
STOCK_SYNC_DISPATCHER_SCAN_LIMIT=20
STOCK_SYNC_PARTIAL_RETRY_MS=60000
