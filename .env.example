DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
CLASSIFICATION_AGENT_PROVIDER=rules

# Production access control. Leave empty for local-only development.
STOCK_APP_BASIC_AUTH_USER=
STOCK_APP_BASIC_AUTH_PASSWORD=
STOCK_OPERATIONS_TOKEN=
STOCK_FORCE_HTTPS=false

# Per-client request limits in a rolling fixed window.
STOCK_RATE_LIMIT_WINDOW_MS=60000
STOCK_RATE_LIMIT_AI_PER_MINUTE=12
STOCK_RATE_LIMIT_WRITE_PER_MINUTE=120
STOCK_RATE_LIMIT_READ_PER_MINUTE=360
STOCK_API_MAX_BODY_BYTES=2097152
STOCK_IMPORT_MAX_BYTES=10485760

# SQLite and operational backups.
STOCK_CLASSIFICATION_DB_PATH=./data/stock-classification.sqlite
STOCK_DB_ENFORCE_PRIVATE_PERMISSIONS=true
STOCK_BACKUP_DIR=./backups

# Stock profile providers are fail-open except eastmoney_push2.
# Available: eastmoney_push2,tencent_quote,eastmoney_f10_company_survey,eastmoney_f10_business_analysis,
#            baidu_related_blocks,cninfo_announcements,eastmoney_reports,
#            sina_income_statement,sina_balance_sheet,sina_cash_flow
STOCK_PROFILE_SOURCE_PRIORITY=eastmoney_push2,tencent_quote,eastmoney_f10_company_survey,eastmoney_f10_business_analysis,baidu_related_blocks,cninfo_announcements,eastmoney_reports,sina_income_statement,sina_balance_sheet,sina_cash_flow
STOCK_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
STOCK_PROVIDER_CIRCUIT_COOLDOWN_MS=60000
STOCK_SYNC_DISPATCHER_ENABLED=true
STOCK_SYNC_DISPATCHER_CONCURRENCY=2
STOCK_SYNC_DISPATCHER_POLL_MS=2000
STOCK_SYNC_DISPATCHER_SCAN_LIMIT=20
STOCK_SYNC_PARTIAL_RETRY_MS=60000
