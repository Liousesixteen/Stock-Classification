{
  "name": "stock-classification",
  "version": "0.1.0-rc.2",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "data:sync:a-share": "node scripts/run-a-share-sync.mjs",
    "backtest:setup": "uv venv --python 3.11 services/da-stock/.venv && uv pip install --python services/da-stock/.venv/bin/python -r services/da-stock/upstream/requirements.txt",
    "dev": "node --env-file-if-exists=.env.local scripts/run-workbench.mjs dev",
    "dev:next": "next dev",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node --env-file-if-exists=.env.local scripts/run-workbench.mjs start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:release-artifacts": "node --test scripts/check-release-artifacts.test.mjs",
    "validate:providers": "RUN_LIVE_PROVIDER_TESTS=1 vitest run tests/live/providerAcceptance.live.test.ts",
    "lint": "eslint .",
    "security:check": "node scripts/check-secrets.mjs",
    "release:check": "node scripts/check-release-artifacts.mjs --root=.next/standalone",
    "db:backup": "node scripts/backup-database.mjs",
    "db:restore": "node scripts/restore-database.mjs",
    "ops:check": "node scripts/operations-check.mjs",
    "report-engine:setup": "python3 -m venv services/finsight/.venv && services/finsight/.venv/bin/python -m pip install -r services/finsight/requirements.txt",
    "report-engine:test": "CRAWL4_AI_BASE_DIRECTORY=./data/finsight-runtime PYTHONDONTWRITEBYTECODE=1 services/finsight/.venv/bin/python -m pytest services/finsight/tests -p no:cacheprovider",
    "report-engine:backend": "CRAWL4_AI_BASE_DIRECTORY=./data/finsight-runtime services/finsight/.venv/bin/python services/finsight/demo/backend/app.py"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^13.0.3",
    "docx": "^9.7.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.25",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.169.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.169.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.25",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
